DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require
PAYLOAD_SECRET=replace-with-a-long-random-string
PREVIEW_SECRET=replace-with-a-long-random-string

# Authorizes Vercel Cron's calls to app/(frontend)/next/cron/publish-scheduled
# (auto-publishes any Page whose `publishAt` has passed — see
# collections/Pages.ts). Only needs to be set in Vercel's own dashboard,
# not locally, unless testing the cron route directly. Not set yet as of
# writing. Runs once a day (vercel.json's "0 8 * * *", chosen to land on
# actual Pacific-time midnight — see that route's own header comment for
# the timezone reasoning and its tradeoffs) — well within even Vercel's
# free Hobby-tier cron limits, so no plan requirement to worry about here.
CRON_SECRET=replace-with-a-long-random-string

# Absolute site URL (no trailing slash) — needed anywhere a link has to be
# sent somewhere external (e.g. to Facebook/Instagram/TikTok, via
# lib/socialPost.ts) and a relative path won't do.
SITE_URL=http://localhost:3000

# From Post for Me's dashboard: one API key, plus one account id per
# connected platform (via GET /v1/social-accounts?platform=<facebook|
# instagram|tiktok> once each account is connected there) — see
# lib/socialPost.ts. Each platform mocks independently: leave any one
# account id unset (even with the API key and the other two set) to run
# that platform in mock mode while the others post for real.
POSTFORME_API_KEY=
POSTFORME_FACEBOOK_ACCOUNT_ID=
POSTFORME_INSTAGRAM_ACCOUNT_ID=
POSTFORME_TIKTOK_ACCOUNT_ID=

# Cloudinary (free tier) — powers the News "Video Studio" (music/text
# overlay on an uploaded video), see lib/cloudinaryVideo.ts and
# components/admin/CloudinaryVideoStudio.tsx. All 3 base values come from
# the Cloudinary console: Settings > API Keys for the key/secret, the main
# Dashboard page for the cloud name. CLOUDINARY_API_SECRET is sensitive —
# never expose it client-side; it's only read server-side (the signing
# route). The two NEXT_PUBLIC_ vars duplicate the cloud name and key
# client-side (both are safe to expose per Cloudinary's own docs — only
# the secret isn't) because next-cloudinary's upload widget needs them in
# the browser to build a *signed* upload request, and the admin Studio's
# live preview / the public post page need the cloud name client-side too
# to build the transformation URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
