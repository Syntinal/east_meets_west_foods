DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require
PAYLOAD_SECRET=replace-with-a-long-random-string
PREVIEW_SECRET=replace-with-a-long-random-string

# Absolute site URL (no trailing slash) — needed anywhere a link has to be
# sent somewhere external (e.g. to Facebook, via lib/facebookPost.ts) and a
# relative path won't do.
SITE_URL=http://localhost:3000

# From Buffer's dashboard (Settings → API, for the key; the Facebook
# Page's Buffer channel id via the API explorer's `channels` query) once
# the Page is connected there — see lib/facebookPost.ts. Leave unset to
# run in mock mode (no real posts sent, everything simulated/logged).
BUFFER_API_KEY=
BUFFER_FACEBOOK_CHANNEL_ID=
